# Copie para .env (não versionado) ou exporte no shell. Alternativa: um perfil em ~/.databrickscfg + --profile.
DATABRICKS_HOST=https://<seu-workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=<token pessoal>   # ou autentique com: databricks auth login --host $DATABRICKS_HOST
# Warehouse SQL usado pelos scripts de análise (scripts/grafico_linkedin.py)
DATABRICKS_WAREHOUSE_ID=<id-do-warehouse>
